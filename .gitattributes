# Declare files that will always have LF line endings on checkout.
META-INF/** text eol=lf
*.prop text eol=lf
*.conf text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.html text eol=lf
kernel.tag text eol=lf
kernel.version text eol=lf

# Denote all files that are truly binary and should not be modified.
binary/** binary
